# Optional OAuth client, see docs/setup.md. Uncomment both lines or neither.
# TAILHOME_CLIENT_ID='your-client-id'
# TAILHOME_CLIENT_SECRET='tskey-client-your-secret'

# Device discovery is on by default; set off to list only Services.
TAILHOME_DEVICES=on
# Icons come from cdn.jsdelivr.net; set off to make no request there.
# TAILHOME_ICONS=off
# Comma-separated tags; any match qualifies. Empty includes untagged devices.
# A nonempty filter excludes untagged laptops; do not tag one just for discovery.
TAILHOME_DEVICE_TAGS=
# Optional extra HTTPS discovery ports; empty still checks port 443 and reads cards there.
# This does not authorize an agent to publish. See docs/setup.md#preview-ports.
# TAILHOME_PREVIEW_PORTS=8443-8452
# Accept certificate errors from devices with one of these tags.
# Example: tag:nas for a NAS with its own certificate. Browsers still warn.
TAILHOME_DEVICE_INSECURE_TLS_TAGS=
